// Esquema de datos — Sistema web ENCUENTRO v2.7
//
// Las tablas se introducen en la fase que las requiere, con su migración y sus
// pruebas. Cubre P03 (gestiones, identidad, RBAC y auditoría), P04
// (autenticación) y P05 (catálogo e inscripción). Hospedaje llega en P06, y
// pagos y comprobantes en P07.
//
// Convenciones (requirements.md §10 y data-api-rbac.md §1):
//   - Fechas en UTC; la presentación usa events.timezone.
//   - Dinero en Decimal, nunca Float. Aún no hay columnas monetarias.
//   - Sin borrado físico en tablas históricas (GOV-009).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: la URL de conexión vive en `prisma.config.ts`, no aquí.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identidad
// ---------------------------------------------------------------------------

/// Persona con acceso al sistema.
///
/// Deliberadamente sin credenciales, sesiones ni tokens: DEC-016 sigue
/// BLOCKING y es la que decide el mecanismo de autenticación. Este registro es
/// la identidad, no el mecanismo, y hace falta para que `audit_logs.actor_id`
/// apunte a algo real.
model User {
  id          String @id @default(uuid()) @db.Uuid
  email       String @unique @db.Citext
  displayName String @map("display_name")
  status      String @default("ACTIVE")

  /// DEC-013: la verificación de correo es obligatoria. La cuenta puede
  /// existir sin verificar; lo que se bloquea es completar la inscripción.
  emailVerified Boolean @default(false) @map("email_verified")

  /// DEC-014: MFA obligatorio para toda cuenta con asignación de rol.
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  image String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments RoleAssignment[]
  auditLogs   AuditLog[]
  sessions    Session[]
  accounts    Account[]
  twoFactors  TwoFactor[]
  person      Person?
  rates       ExchangeRate[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Autenticación — DEC-016, ADR-010
//
// Better Auth resuelve identidad y sesión. La autorización sigue en el dominio:
// estas tablas no contienen permisos ni scopes.
// ---------------------------------------------------------------------------

/// Sesión activa.
///
/// Se persiste en base y no solo en cookie firmada, para poder revocarla de
/// inmediato. Una cookie firmada solo caduca; una fila se borra.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Credencial asociada a una cuenta.
///
/// `password` guarda el hash, nunca la contraseña. El nombre lo fija Better
/// Auth; el contenido es un hash con sal.
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Valor de verificación de un solo uso: correo, restablecimiento, reto MFA.
///
/// DEC-013: el token tiene vencimiento y se consume al usarse.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

/// Segundo factor TOTP — DEC-014.
///
/// `secret` y `backupCodes` se almacenan cifrados por Better Auth y nunca se
/// devuelven en una respuesta ni se escriben en auditoría.
model TwoFactor {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  secret      String
  backupCodes String @map("backup_codes")

  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

// ---------------------------------------------------------------------------
// RBAC — requirements.md §10, ADR-003
// ---------------------------------------------------------------------------

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@map("roles")
}

/// Permiso concedido a un rol.
///
/// `permission` es texto libre a nivel de base y se valida contra
/// `contracts/permissions.json` en la capa de aplicación. Un enum de Postgres
/// obligaría a migrar el esquema cada vez que el contrato añade un permiso, y
/// el contrato es la fuente de verdad, no la base.
model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

/// Tasa de cambio del día — DEC-009, cierra TBD-001.
///
/// La decisión congela la tasa al cargar la evidencia y
/// `payment_proofs.exchange_rate_micros` existe para guardarla; lo que faltaba
/// era de dónde sacarla. La registra una persona con permiso, no una fuente
/// web: el número acaba impreso en un comprobante y sostiene una conciliación,
/// así que tiene que haber alguien que responda por él.
///
/// Esta tabla es la **referencia**. Lo que congela el comprobante es una copia:
/// corregir una tasa después no cambia lo que ya se cobró.
model ExchangeRate {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  /// La moneda extranjera. La de destino es siempre la de la gestión.
  currency String @db.Char(3)

  /// Micros, igual que en `payment_proofs`: entero, nunca `float` (NFR-014).
  /// 6,96 BOB por dólar se guarda como 6960000.
  rateMicros BigInt @map("rate_micros")

  /// Día civil de la gestión al que aplica. La tasa es del día, no del instante.
  effectiveOn DateTime @map("effective_on") @db.Date

  /// Quién la registró: es lo que hace defendible el número.
  actorId String @map("actor_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actor User  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([eventId, currency, effectiveOn])
  @@index([eventId, effectiveOn(sort: Desc)])
  @@map("exchange_rates")
}

/// Comisión de una gestión — EVT-002, SRV-001, ACC-007, ACC-014.
///
/// Hasta el 11 de agosto de 2026 no existía: el alcance de comisión era un
/// código en texto libre sin integridad referencial, y el plan de cuentas de la
/// organización compensaba esa ausencia abriendo una subcuenta por comisión
/// —124 de sus 226 cuentas—.
///
/// Por gestión y no global: una comisión que desaparece de una edición a la
/// siguiente no debe arrastrar permisos ni asientos. Es la misma razón por la
/// que las asignaciones de rol tampoco se copian.
model Commission {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  code String
  name String

  /// Agrupación que la organización ya usa en su plan: espiritualidad,
  /// atención al peregrino, alimentación, comunicación, logística, liturgia y
  /// comisiones de apoyo.
  area String

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  assignments RoleAssignment[]
  entries     JournalEntry[]

  @@unique([eventId, code])
  @@index([eventId, area])
  @@map("commissions")
}

/// Asignación de un rol a una persona dentro de un ámbito.
///
/// Los cuatro scopes son global, gestión, comisión y caja. Las columnas de
/// ámbito son nullable porque cada tipo usa unas u otras; la coherencia la
/// garantiza un CHECK en la migración, no la aplicación.
model RoleAssignment {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  roleId        String  @map("role_id") @db.Uuid
  scopeType     String  @map("scope_type")
  eventId       String? @map("event_id") @db.Uuid
  commissionId  String? @map("commission_id") @db.Uuid
  /// `cashAccountId` sigue siendo un código sin tabla propia: las cajas llegan
  /// con su fase. La comisión dejó de serlo.
  cashAccountId String? @map("cash_account_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  event      Event?      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  commission Commission? @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([eventId])
  @@index([commissionId])
  @@map("role_assignments")
}

// ---------------------------------------------------------------------------
// Gestiones — EVT-001 … EVT-006, EVT-016, EVT-009, EVT-010
// ---------------------------------------------------------------------------

/// Edición anual del Encuentro.
///
/// `version` implementa el bloqueo optimista: toda transición hace
/// compare-and-swap sobre ella, de modo que dos operaciones concurrentes no
/// puedan aplicarse ambas (GOV-006, system-architecture.md §7).
model Event {
  id       String @id @default(uuid()) @db.Uuid
  code     String @unique
  year     Int    @unique
  name     String
  timezone String

  startAt DateTime @map("start_at") @db.Timestamptz(6)
  endAt   DateTime @map("end_at") @db.Timestamptz(6)

  /// Moneda base de la gestión, ISO 4217.
  currency String @db.Char(3)

  status  String @default("DRAFT")
  version Int    @default(1)

  /// Marca la única gestión públicamente habilitada (EVT-006).
  ///
  /// Es `true` o `NULL`, nunca `false`: un índice único parcial sobre esta
  /// columna deja que exista como mucho una fila con `true`. Un booleano normal
  /// no puede expresar esa restricción sin un índice único parcial adicional.
  publiclyEnabled Boolean? @map("publicly_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments    RoleAssignment[]
  auditLogs      AuditLog[]
  packages       Package[]
  registrations  Registration[]
  lodgingPolicy  EventLodgingPolicy?
  hotels         Hotel[]
  reservations   Reservation[]
  paymentProofs  PaymentProof[]
  payments       Payment[]
  receipts       Receipt[]
  cashSessions   CashSession[]
  credentials    Credential[]
  stations       Station[]
  mealServices   MealService[]
  inventory      InventoryItem[]
  vehicles       Vehicle[]
  accounts       Account_[]
  commissions    Commission[]
  exchangeRates  ExchangeRate[]
  journalEntries JournalEntry[]
  notifications  Notification[]

  @@map("events")
}

// ---------------------------------------------------------------------------
// Auditoría — GOV-005, GOV-009
// ---------------------------------------------------------------------------

/// Registro append-only de mutaciones sensibles.
///
/// La migración instala un trigger que rechaza UPDATE y DELETE. Sin él, la
/// regla «no se reescribe» dependería de que nadie escriba el código
/// equivocado; con él, la base la impone aunque alguien lo intente desde psql.
///
/// `beforeRedacted` y `afterRedacted` guardan el estado ya redactado: la PII no
/// debe llegar al registro (regla 03-security-rbac).
model AuditLog {
  id      String  @id @default(uuid()) @db.Uuid
  eventId String? @map("event_id") @db.Uuid
  actorId String  @map("actor_id") @db.Uuid

  action   String
  entity   String
  entityId String  @map("entity_id")
  reason   String?

  beforeRedacted Json? @map("before_redacted")
  afterRedacted  Json? @map("after_redacted")

  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict)
  actor User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([eventId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catálogo e inscripción — P05
//
// PKG-001, PKG-009, PKG-010, PKG-012, PKG-013 y REG-019, PAY-001, REG-020, REG-021, REG-022, REG-023, PKG-011, HOS-015. Los importes son `Decimal`, nunca `Float`
// (requirements.md §10); el dominio los maneja como enteros de centavos.
// ---------------------------------------------------------------------------

/// Persona física.
///
/// Se separa de `User` a propósito: `User` es una cuenta con credenciales,
/// `Person` es el ser humano que asiste. Alguien inscrito presencialmente puede
/// existir como persona antes de tener cuenta.
///
/// `birthDate` es obligatoria por DEC-006: sin ella no se puede rechazar a un
/// menor, y rechazarlo es una regla dura.
model Person {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @unique @map("user_id") @db.Uuid

  fullName  String   @map("full_name")
  birthDate DateTime @map("birth_date") @db.Date

  /// PAY-030: el Comprobante de pago **no** muestra documento ni país. Se
  /// guardan para identificación interna, no para exhibirlos.
  documentNumber String? @map("document_number")
  country        String? @db.Char(2)
  phone          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  registrations Registration[]

  @@map("persons")
}

/// Paquete comercial de una gestión.
///
/// PKG-009: `visibility` admite `PUBLIC` y `PRIVATE`. El portal solo lista los
/// públicos; los privados los asigna Inscripciones con `catalog.private.assign`.
model Package {
  id         String @id @default(uuid()) @db.Uuid
  eventId    String @map("event_id") @db.Uuid
  code       String
  name       String
  visibility String @default("PUBLIC")
  status     String @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  priceVersions PriceVersion[]
  registrations Registration[]

  @@unique([eventId, code])
  @@index([eventId, visibility])
  @@map("packages")
}

/// Versión histórica de precio.
///
/// PKG-012: la tarifa anticipada y la normal son importes **explícitos**, no un
/// descuento derivado. De ahí que no exista ninguna columna de porcentaje de
/// descuento: son dos filas independientes, una por modalidad.
///
/// PKG-001: cambiar el precio crea una fila nueva. Las existentes no se tocan,
/// porque hay cargos congelados que las referencian.
model PriceVersion {
  id          String @id @default(uuid()) @db.Uuid
  packageId   String @map("package_id") @db.Uuid
  paymentMode String @map("payment_mode")

  amount   Decimal @db.Decimal(12, 2)
  currency String  @db.Char(3)

  /// Vigencia de la tarifa anticipada. `ARRIVAL` no la usa.
  startsAt DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(6)

  /// PKG-013: mínimo de pago que desbloquea el beneficio, y vencimiento del saldo.
  minPaymentPercent Int?      @map("min_payment_percent")
  balanceDueAt      DateTime? @map("balance_due_at") @db.Timestamptz(6)

  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  package       Package        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  registrations Registration[]

  /// Permite la clave foránea compuesta desde `registrations`, que garantiza
  /// que una inscripción no use la versión de precio de otro paquete.
  @@unique([id, packageId], map: "price_versions_package_unique")
  @@index([packageId, paymentMode])
  @@map("price_versions")
}

/// Inscripción de una persona en una gestión.
///
/// PAY-001: congela paquete, versión de precio, modalidad e importe. El
/// histórico no se reescribe (GOV-005).
model Registration {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  /// Código visible de la inscripción. Aparece en el Comprobante (PAY-030).
  code String

  personId       String @map("person_id") @db.Uuid
  packageId      String @map("package_id") @db.Uuid
  priceVersionId String @map("price_version_id") @db.Uuid

  /// REG-019: exactamente una modalidad. No confundir con el canal de pago.
  paymentMode String @map("payment_mode")

  status           String @default("DRAFT")
  attendanceStatus String @default("NOT_ARRIVED") @map("attendance_status")

  /// HOS-013: la llegada real no reescribe la reserva ni el importe.
  actualArrivalAt DateTime? @map("actual_arrival_at") @db.Timestamptz(6)

  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event              Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  person             Person             @relation(fields: [personId], references: [id], onDelete: Restrict)
  package            Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  /// Referencia **compuesta** a propósito: al incluir `packageId`, la base
  /// impide que una inscripción use la versión de precio de otro paquete.
  /// Declararla aquí y no solo en SQL evita que Prisma la vea como deriva y la
  /// elimine en la siguiente migración, que es exactamente lo que ocurrió.
  priceVersion       PriceVersion       @relation(fields: [priceVersionId, packageId], references: [id, packageId], onDelete: Restrict)
  charges            Charge[]
  reservations       Reservation[]
  paymentProofs      PaymentProof[]
  payments           Payment[]
  credential         Credential?
  mealDeliveries     MealDelivery[]
  materialDeliveries MaterialDelivery[]

  /// Una persona no se inscribe dos veces en la misma gestión.
  @@unique([eventId, personId])
  @@unique([eventId, code])
  @@index([eventId, status])
  @@map("registrations")
}

/// Cargo congelado de una inscripción.
///
/// PAY-001: el snapshot conserva las condiciones del momento. Un cambio
/// posterior de tarifa no lo altera.
model Charge {
  id             String @id @default(uuid()) @db.Uuid
  registrationId String @map("registration_id") @db.Uuid

  concept  String
  amount   Decimal @db.Decimal(12, 2)
  currency String  @db.Char(3)

  /// Condiciones congeladas: paquete, versión, modalidad e importe (PAY-001).
  snapshot Json @map("snapshot_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  registration Registration        @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]

  @@index([registrationId])
  @@map("charges")
}

// ---------------------------------------------------------------------------
// Hospedaje — P06
//
// HOS-011, HOS-013, HOS-012, HOS-003, HOS-016, HOS-017, HOS-001, HOS-002 y DEC-005. La cantidad de noches es configuración, no cálculo;
// la llegada tardía no reescribe nada; y el último cupo lo resuelve la base.
// ---------------------------------------------------------------------------

/// Política de hospedaje de una gestión.
///
/// HOS-011: cantidad **fija y configurable** de noches. La referencia actual
/// son 7, pero ese número no aparece en el código ni por defecto aquí: se
/// configura al preparar la gestión.
model EventLodgingPolicy {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @unique @map("event_id") @db.Uuid

  nightCount   Int      @map("night_count")
  checkInDate  DateTime @map("check_in_date") @db.Date
  checkOutDate DateTime @map("check_out_date") @db.Date

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@map("event_lodging_policies")
}

model Hotel {
  id      String  @id @default(uuid()) @db.Uuid
  eventId String  @map("event_id") @db.Uuid
  code    String
  name    String
  address String?
  status  String  @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  rooms        Room[]
  reservations Reservation[]

  @@unique([eventId, code])
  @@map("hotels")
}

/// Habitación con su capacidad.
///
/// HOS-002: la capacidad se controla por **inventario**, no por un contador
/// que pueda desincronizarse. Cada plaza ocupada es una fila de `reservations`
/// con su `bed_index`, y un índice único impide que dos personas ocupen la
/// misma plaza.
model Room {
  id       String @id @default(uuid()) @db.Uuid
  hotelId  String @map("hotel_id") @db.Uuid
  code     String
  capacity Int

  status String @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  hotel        Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@unique([hotelId, code])
  @@map("rooms")
}

/// Reserva de hospedaje.
///
/// HOS-012: una reserva `CONFIRMED` no se libera por llegada tardía. El worker
/// que expira retenciones filtra por `HELD`; nada más.
///
/// HOS-001: la habitación la asigna Hospedaje, así que `room_id` es nullable
/// hasta que alguien con `lodging.assign_room` la fije.
model Reservation {
  id             String @id @default(uuid()) @db.Uuid
  eventId        String @map("event_id") @db.Uuid
  registrationId String @map("registration_id") @db.Uuid
  hotelId        String @map("hotel_id") @db.Uuid

  roomId String? @map("room_id") @db.Uuid

  /// Plaza concreta dentro de la habitación. Junto al índice único sobre
  /// (room_id, bed_index) es lo que impide vender dos veces el mismo cupo.
  bedIndex Int? @map("bed_index")

  checkInDate  DateTime @map("check_in_date") @db.Date
  checkOutDate DateTime @map("check_out_date") @db.Date
  nightCount   Int      @map("night_count")

  status String @default("HELD")

  /// DEC-005: solo aplica a `HELD`. Se calcula al crear la retención.
  heldUntil DateTime? @map("held_until") @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  hotel        Hotel        @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([eventId, status])
  @@index([hotelId, status])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Facturación — P07
//
// PAY-002, PAY-014, PAY-018, PAY-022, PAY-023, PAY-024, PAY-025, PAY-026, PAY-027, PAY-028, PAY-029, PAY-030, PAY-031, PAY-032, PAY-033, PAY-011, PAY-012 y DEC-003, DEC-007, DEC-008, DEC-009, DEC-015.
//
// v1 no tiene checkout automático: nada confirma un pago salvo una persona
// revisando una evidencia. No hay tabla de proveedores ni de webhooks porque no
// existe tal cosa en el alcance.
// ---------------------------------------------------------------------------

/// Canal por el que entra el dinero — PAY-023, PAY-024.
///
/// El canal **no es la modalidad**: alguien con modalidad anticipada puede
/// pagar por cualquier canal habilitado (DEC-002).
model PaymentChannel {
  id      String  @id @default(uuid()) @db.Uuid
  eventId String? @map("event_id") @db.Uuid
  code    String
  scope   String  @default("EVENT")

  currency     String  @db.Char(3)
  instructions String?
  active       Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  proofs PaymentProof[]

  @@unique([eventId, code])
  @@map("payment_channels")
}

/// Evidencia de pago cargada por el peregrino — PAY-018, PAY-025, PAY-026, PAY-027.
///
/// PAY-025: subirla **no confirma nada**. Solo la aprobación crea un pago.
/// PAY-018: el archivo es privado y se guarda su checksum.
model PaymentProof {
  id             String @id @default(uuid()) @db.Uuid
  eventId        String @map("event_id") @db.Uuid
  registrationId String @map("registration_id") @db.Uuid
  channelId      String @map("channel_id") @db.Uuid

  declaredAmount Decimal  @map("declared_amount") @db.Decimal(12, 2)
  currency       String   @db.Char(3)
  paidAt         DateTime @map("paid_at") @db.Timestamptz(6)

  /// PAY-027: referencia bancaria. Un índice único por gestión impide cargar
  /// dos veces el mismo comprobante.
  ///
  /// `Citext` porque el índice distinguía mayúsculas: `TRX-9981` y `trx-9981`
  /// convivían como evidencias distintas de la misma transferencia, y el mismo
  /// comprobante bancario podía aprobarse dos veces. Mismo motivo por el que
  /// `users.email` lo es (IAM-001). No normaliza espacios ni guiones: fusionar
  /// esos rechazaría referencias genuinamente distintas.
  reference String @db.Citext
  payerName String? @map("payer_name")

  /// Archivo privado. Se guarda la referencia y el checksum, nunca el binario.
  fileId       String? @map("file_id")
  fileChecksum String? @map("file_checksum")

  /// DEC-009: tasa congelada **al cargar la evidencia**, no al aprobarla.
  /// Se guarda en millonésimas para operar con enteros.
  exchangeRateMicros BigInt? @map("exchange_rate_micros")

  status String @default("SUBMITTED")

  submittedAt  DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewReason String?   @map("review_reason")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration   @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  channel      PaymentChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  payment      Payment?

  @@unique([eventId, reference])
  @@index([eventId, status])
  @@map("payment_proofs")
}

/// Sesión de caja — PAY-011, PAY-012.
///
/// PAY-011: todo cobro presencial ocurre dentro de una sesión abierta.
model CashSession {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  cashAccountCode String @map("cash_account_code")
  currency        String @db.Char(3)

  openedBy String   @map("opened_by") @db.Uuid
  openedAt DateTime @default(now()) @map("opened_at") @db.Timestamptz(6)

  closedBy String?   @map("closed_by") @db.Uuid
  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)

  /// PAY-012: el cierre compara esperado contra contado. La diferencia se
  /// calcula; si difiere, exige motivo.
  expectedAmount Decimal? @map("expected_amount") @db.Decimal(12, 2)
  countedAmount  Decimal? @map("counted_amount") @db.Decimal(12, 2)
  closeReason    String?  @map("close_reason")

  status String @default("OPEN")

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([eventId, status])
  @@map("cash_sessions")
}

/// Pago confirmado.
///
/// Un pago existe porque una persona autorizada aprobó una evidencia o cobró en
/// caja. Es inmutable: las correcciones se hacen por reversión o anulación
/// (GOV-005), nunca reescribiendo la fila.
model Payment {
  id             String  @id @default(uuid()) @db.Uuid
  eventId        String  @map("event_id") @db.Uuid
  registrationId String? @map("registration_id") @db.Uuid

  amount   Decimal @db.Decimal(12, 2)
  currency String  @db.Char(3)

  method String
  status String @default("SUCCEEDED")

  sourceProofId String? @unique @map("source_proof_id") @db.Uuid
  cashSessionId String? @map("cash_session_id") @db.Uuid

  approvedBy String   @map("approved_by") @db.Uuid
  approvedAt DateTime @default(now()) @map("approved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event        Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration?       @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  sourceProof  PaymentProof?       @relation(fields: [sourceProofId], references: [id], onDelete: Restrict)
  cashSession  CashSession?        @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]
  receipt      Receipt?

  @@index([eventId, status])
  @@map("payments")
}

/// Asignación de un pago a un cargo — PAY-002.
///
/// El saldo se deriva de estas filas. Nunca se edita a mano.
model PaymentAllocation {
  id        String @id @default(uuid()) @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  chargeId  String @map("charge_id") @db.Uuid

  amount   Decimal @db.Decimal(12, 2)
  currency String  @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  charge  Charge  @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([chargeId])
  @@map("payment_allocations")
}

/// Comprobante de pago — PAY-028, PAY-014, PAY-029, PAY-030, PAY-031, PAY-032, PAY-033, DEC-003.
///
/// PAY-028: cada pago aprobado genera el suyo, incluido un pago parcial.
/// PAY-014: secuencia `REC-{EVENT_CODE}-{NNNNNN}` única por gestión.
/// PAY-033: inmutable. Una corrección se resuelve anulando y emitiendo otro.
model Receipt {
  id        String @id @default(uuid()) @db.Uuid
  eventId   String @map("event_id") @db.Uuid
  paymentId String @unique @map("payment_id") @db.Uuid

  sequence Int
  number   String

  /// Contenido congelado en el momento de emitir. PAY-030 limita los datos del
  /// peregrino a nombre, código de inscripción y paquete: sin documento ni país.
  snapshot Json @map("snapshot_json")

  /// DEC-003: token opaco de alta entropía, almacenado **por hash**. El valor en
  /// claro solo existe dentro del QR impreso; la base nunca puede devolverlo.
  verificationTokenHash String @unique @map("verification_token_hash")

  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedBy   String?   @map("voided_by") @db.Uuid
  voidReason String?   @map("void_reason")

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([eventId, sequence])
  @@unique([eventId, number])
  @@index([eventId, issuedAt])
  @@map("receipts")
}

// ---------------------------------------------------------------------------
// Credenciales, alimentos, materiales y transporte — P08 a P11
//
// **Advertencia de procedencia.** Solo FOD-001, FOD-006, FOD-002, FOD-003 y MAT-005, MAT-004, MAT-003 tienen
// requisitos en `contracts/requirements.json`. Credenciales, escaneo offline y
// transporte se construyen por inferencia desde `system-architecture.md` §5 y
// los prompts P08–P10, por decisión explícita del responsable del proyecto.
// Las reglas inferidas están marcadas con «INFERIDO» y listadas en el informe
// de la fase para poder auditarlas una a una.
// ---------------------------------------------------------------------------

/// Credencial de una inscripción — INFERIDO (P08).
///
/// El token sigue el mismo patrón que el del Comprobante (DEC-003): opaco,
/// almacenado por hash, sin PII. Esa parte no es inferencia — requirements.md
/// §10 lo exige para todo QR del sistema.
model Credential {
  id             String @id @default(uuid()) @db.Uuid
  eventId        String @map("event_id") @db.Uuid
  registrationId String @unique @map("registration_id") @db.Uuid

  code String

  /// requirements.md §10: los tokens de QR se almacenan por hash y no
  /// contienen PII.
  tokenHash String @unique @map("token_hash")

  status String @default("ACTIVE")

  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)

  @@unique([eventId, code])
  @@map("credentials")
}

/// Estación de escaneo — INFERIDO (P09).
model Station {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  code    String
  name    String
  kind    String @default("GENERAL")
  status  String @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event              Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  mealDeliveries     MealDelivery[]
  materialDeliveries MaterialDelivery[]

  @@unique([eventId, code])
  @@map("stations")
}

/// Servicio de alimentación — FOD-001.
///
/// Requisito real: fecha, tipo, hora inicial y final, y cantidad disponible.
model MealService {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  serviceDate DateTime @map("service_date") @db.Date
  type        String

  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  /// FOD-002: pedido, recepción, desperdicio y entrega son movimientos
  /// separados y reconciliables.
  availableCount Int @map("available_count")
  orderedCount   Int @default(0) @map("ordered_count")
  receivedCount  Int @default(0) @map("received_count")
  wastedCount    Int @default(0) @map("wasted_count")

  status String @default("ACTIVE")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event      Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  deliveries MealDelivery[]

  @@unique([eventId, serviceDate, type])
  @@index([eventId, serviceDate])
  @@map("meal_services")
}

/// Entrega de una comida — FOD-003.
///
/// Una persona recibe una vez cada servicio: lo garantiza el índice único
/// (service_id, registration_id), no una comprobación en código.
model MealDelivery {
  id             String @id @default(uuid()) @db.Uuid
  serviceId      String @map("service_id") @db.Uuid
  registrationId String @map("registration_id") @db.Uuid
  stationId      String @map("station_id") @db.Uuid

  /// ADR-008: idempotencia por estación y operación. Reenviar el mismo escaneo
  /// tras recuperar la conexión no entrega dos veces.
  operationUuid String @map("operation_uuid")

  deliveredAt DateTime @default(now()) @map("delivered_at") @db.Timestamptz(6)

  /// FOD-003 admite override autorizado; queda registrado quién lo hizo.
  overriddenBy   String? @map("overridden_by") @db.Uuid
  overrideReason String? @map("override_reason")

  service      MealService  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  station      Station      @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([serviceId, registrationId])
  @@unique([stationId, operationUuid])
  @@index([serviceId])
  @@map("meal_deliveries")
}

/// Artículo de inventario — MAT-003.
model InventoryItem {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  code    String
  name    String
  status  String @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event      Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  movements  InventoryMovement[]
  deliveries MaterialDelivery[]

  @@unique([eventId, code])
  @@map("inventory_items")
}

/// Movimiento de inventario — MAT-003.
///
/// «Stock deriva de movimientos». No hay columna de existencias que alguien
/// pueda corregir a mano, igual que no hay columna de saldo en facturación.
model InventoryMovement {
  id     String @id @default(uuid()) @db.Uuid
  itemId String @map("item_id") @db.Uuid

  kind     String
  quantity Int

  reason    String?
  actorId   String   @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@map("inventory_movements")
}

/// Entrega de material — MAT-005, MAT-004.
model MaterialDelivery {
  id             String @id @default(uuid()) @db.Uuid
  itemId         String @map("item_id") @db.Uuid
  registrationId String @map("registration_id") @db.Uuid
  stationId      String @map("station_id") @db.Uuid

  operationUuid String @map("operation_uuid")
  quantity      Int    @default(1)

  deliveredAt DateTime @default(now()) @map("delivered_at") @db.Timestamptz(6)

  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  registration Registration  @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  station      Station       @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([itemId, registrationId])
  @@unique([stationId, operationUuid])
  @@map("material_deliveries")
}

/// Vehículo de transporte — INFERIDO (P10).
///
/// El prompt P10 nombra «vehículos, choferes, horarios, asignaciones y QR» y
/// pide un gate de solapamientos y capacidad. No hay requisitos TRANS-* en el
/// contrato: todo este modelo es inferencia.
model Vehicle {
  id         String  @id @default(uuid()) @db.Uuid
  eventId    String  @map("event_id") @db.Uuid
  code       String
  plate      String?
  capacity   Int
  driverName String? @map("driver_name")
  status     String  @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  trips Trip[]

  @@unique([eventId, code])
  @@map("vehicles")
}

/// Traslado — INFERIDO (P10).
model Trip {
  id        String @id @default(uuid()) @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid

  origin      String
  destination String

  departsAt DateTime @map("departs_at") @db.Timestamptz(6)
  arrivesAt DateTime @map("arrives_at") @db.Timestamptz(6)

  status String @default("SCHEDULED")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId, departsAt])
  @@map("trips")
}

// ---------------------------------------------------------------------------
// Contabilidad — P12
//
// **Advertencia de procedencia.** No hay requisitos ACC-* en el contrato. Todo
// este bloque es inferencia desde el prompt P12, por decisión explícita del
// responsable del proyecto.
//
// Una excepción: la partida doble **no** es inferencia. Que los débitos igualen
// a los créditos es la definición del método, y un CHECK lo impone.
//
// requirements.md §2 excluye presupuestos y centros de costo visibles del
// alcance v1, así que no existen aquí.
// ---------------------------------------------------------------------------

/// Cuenta contable — INFERIDO.
///
/// Se llama `Account_` porque `Account` ya lo ocupa Better Auth. El nombre de
/// tabla sí es el natural.
model Account_ {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  code String
  name String

  /// Los cinco tipos del método contable estándar.
  kind String

  /// Rol contable de DEC-018. La decisión fija roles; la organización asigna a
  /// cada rol una cuenta de su plan. Es nulo mientras nadie lo haya asignado.
  ///
  /// Un rol corresponde como mucho a una cuenta **por gestión y moneda**: un
  /// plan de cuentas que lleva divisas separa «caja moneda nacional» de «caja
  /// moneda extranjera», y las dos son el mismo rol. El índice único que lo
  /// impone vive en la migración `20260811180000_accounts_role_per_currency`.
  role String?

  currency String  @db.Char(3)
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  lines JournalLine[]

  @@unique([eventId, code])
  @@map("accounts_chart")
}

/// Asiento contable — INFERIDO en su forma; cuadre obligatorio por definición.
model JournalEntry {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid

  entryDate DateTime @map("entry_date") @db.Date
  memo      String

  /// Origen del asiento: qué operación lo generó. Permite reconstruir la
  /// contabilidad desde los hechos de negocio (GOV-005).
  sourceEntity String? @map("source_entity")
  sourceId     String? @map("source_id")

  /// Tipo de asiento. Junto a la gestión y al origen forma la llave de
  /// idempotencia de ACC-002, impuesta por un índice único parcial.
  entryKind String? @map("entry_kind")

  /// Versión de la regla aplicada. Se guarda para trazabilidad y **no forma
  /// parte de la llave de idempotencia**: incluirla permitiría contabilizar
  /// dos veces la misma fuente al cambiar de versión de reglas.
  ruleVersion Int? @map("rule_version")

  currency String @db.Char(3)

  /// Comisión responsable — ACC-007 y ACC-014.
  ///
  /// Nula a propósito: no todo asiento pertenece a una comisión. Un cobro de
  /// inscripción es de la gestión; un gasto sí tiene responsable, y ACC-007 lo
  /// exige.
  ///
  /// No sustituye a la cuenta. La cuenta dice **qué** y la comisión **quién**:
  /// cuando el plan ya distingue por comisión las dos coinciden, y cuando el
  /// gasto va contra una cuenta genérica la dimensión aporta lo que la cuenta
  /// no sabe. Un disparador impide que sea de otra gestión (EVT-008).
  commissionId String? @map("commission_id") @db.Uuid

  actorId   String   @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event      Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  commission Commission?   @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  lines      JournalLine[]

  @@index([eventId, entryDate])
  @@index([sourceEntity, sourceId])
  @@index([commissionId])
  @@map("journal_entries")
}

/// Línea de asiento.
model JournalLine {
  id      String @id @default(uuid()) @db.Uuid
  entryId String @map("entry_id") @db.Uuid

  accountId String  @map("account_id") @db.Uuid
  side      String
  amount    Decimal @db.Decimal(12, 2)
  currency  String  @db.Char(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account Account_     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Notificaciones — P13
//
// Procedencia mixta. Tres reglas vienen de documentos aprobados:
//   - GOV-007: SMTP, reglas y plantillas son **globales**, sin `event_id`.
//   - GOV-008: una falla de integración no revierte una operación confirmada.
//   - ADR-007: el envío ocurre por outbox y worker, nunca en la petición.
// El catálogo concreto de plantillas es inferencia.
// ---------------------------------------------------------------------------

/// Configuración SMTP — GOV-007.
///
/// **Sin `event_id`**: es global y única. El índice único sobre una columna
/// constante garantiza que solo pueda existir una fila, que es lo que
/// «singleton global» significa.
model SmtpSettings {
  id String @id @default(uuid()) @db.Uuid

  /// Siempre `true`. Un índice único sobre esta columna impide una segunda fila.
  singleton Boolean @unique @default(true)

  host      String
  port      Int
  username  String?
  fromName  String  @map("from_name")
  fromEmail String  @map("from_email")

  secure Boolean @default(true)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("smtp_settings")
}

/// Plantilla de correo — GOV-007: global y versionada.
model NotificationTemplate {
  id   String @id @default(uuid()) @db.Uuid
  code String

  version Int    @default(1)
  subject String
  body    String

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  notifications Notification[]

  @@unique([code, version])
  @@map("notification_templates")
}

/// Envío encolado — ADR-007, GOV-008.
///
/// El `event_id` es opcional: hay avisos ligados a una gestión y otros que no.
/// La plantilla, en cambio, nunca lo lleva (GOV-007).
model Notification {
  id      String  @id @default(uuid()) @db.Uuid
  eventId String? @map("event_id") @db.Uuid

  templateId String @map("template_id") @db.Uuid

  /// Destinatario. Es PII, así que no se replica en auditoría.
  toEmail String @map("to_email")

  /// Variables ya resueltas en el momento de encolar, para que el contenido no
  /// cambie si los datos de origen cambian después.
  variables Json

  status   String @default("PENDING")
  attempts Int    @default(0)

  scheduledAt DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  event    Event?               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  template NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([status, scheduledAt])
  @@index([eventId])
  @@map("notifications")
}

// Esquema de datos — Sistema web ENCUENTRO v2.7
//
// Sin modelos todavía. Las tablas están especificadas en
// `docs/02-architecture/data-api-rbac.md` §2 y se introducen en la fase que
// las requiere, con su migración y sus pruebas: `events` y `audit_logs` en P03,
// `packages`/`price_versions`/`registrations`/`charges` en P05, hospedaje en
// P06, pagos y comprobantes en P07.
//
// Declararlas aquí por adelantado crearía migraciones sin requisito asociado.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: la URL de conexión vive en `prisma.config.ts`, no aquí.
datasource db {
  provider = "postgresql"
}

      "code": "RECONCILIATION_SURPLUS",
      "entryKind": "RECONCILIATION_ADJUSTMENT",
      "sourceType": "reconciliation",
      "trigger": "Diferencia de conciliacion aprobada: sobra dinero frente a lo registrado",
      "debits": [
        {
          "resolver": "FINANCIAL_ACCOUNT_BY_CHANNEL",
          "amount": "differenceAmount"

# Entorno de producción — plantilla.
#
# Copie a `.env` junto a `docker-compose.prod.yml` y rellene. Ningún valor de
# este fichero debe llegar al repositorio.
#
# El compose falla al arrancar si falta cualquiera de las variables marcadas
# como obligatorias: es preferible que no levante a que levante a medias.

# --- Dominio y certificado ---------------------------------------------------
APP_DOMAIN=encuentro.example.org
ACME_EMAIL=operaciones@example.org
APP_URL=https://encuentro.example.org

# --- Base de datos y cache ---------------------------------------------------
POSTGRES_DB=encuentro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Dos roles distintos, creados por `deploy/db-roles.sql` — mitigacion de P03.
#
# `encuentro_app` NO es propietario de ninguna tabla. Esa es la proteccion real
# contra TRUNCATE: los triggers append-only de GOV-009 actuan por fila y
# TRUNCATE no dispara triggers de fila, asi que los esquiva. Solo el propietario
# puede truncar.
#
# La aplicacion en marcha usa DATABASE_URL. Las migraciones usan
# DATABASE_MIGRATION_URL, y solo durante el despliegue.
DATABASE_URL=postgresql://encuentro_app:@postgres:5432/encuentro
DATABASE_MIGRATION_URL=postgresql://encuentro_owner:@postgres:5432/encuentro
REDIS_URL=redis://redis:6379

# --- Secretos de aplicación --------------------------------------------------
# Mínimo 32 caracteres. Genere con: openssl rand -base64 48
SESSION_SECRET=
RECEIPT_VERIFICATION_SECRET=

# --- Almacenamiento de evidencias --------------------------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=encuentro-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Correo ------------------------------------------------------------------
# Host, puerto y remitente se configuran desde /admin/configuracion/correo.
# Aquí solo viaja la contraseña: un secreto en base de datos es un secreto en
# cada respaldo y en cada pantalla de administración.
SMTP_PASSWORD=

# --- Respaldo — DEC-012 ------------------------------------------------------
# Clave de cifrado. **No la rote sin conservar la anterior**: los respaldos ya
# escritos siguen cifrados con la vieja y perderla los vuelve inservibles.
BACKUP_PASSPHRASE=

# Obligatoria y sin valor por defecto. Ponerla en `false` es una decisión
# consciente de operar sin copia externa, y con ella DEC-012 NO se cumple.
BACKUP_REMOTE_ENABLED=false

# Destino externo S3-compatible. Elegido: Backblaze B2.
#
# **Debe estar en un proveedor distinto al que aloja el VPS.** Guardarlo en la
# misma cuenta protege contra perder el servidor, no contra perder la cuenta.
#
# El endpoint lo da B2 al crear el bucket y depende de la región; la región va
# incluida en el propio endpoint (por ejemplo s3.us-west-004.backblazeb2.com).
# Cambiar a OVH, Wasabi, Scaleway o MinIO es cambiar estas variables: el código
# no distingue proveedores.
BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BACKUP_S3_REGION=us-west-004
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=encuentro

# Application Key de B2 con permiso solo sobre este bucket. No use la clave
# maestra de la cuenta: si el VPS se ve comprometido, esta credencial es lo que
# el atacante obtiene, y no debe permitirle borrar el histórico.
BACKUP_S3_KEY_ID=
BACKUP_S3_APPLICATION_KEY=

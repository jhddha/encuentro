# Reverse proxy — DEC-001.
#
# Caddy obtiene y renueva el certificado TLS automáticamente, así que no hay
# renovación manual que pueda olvidarse. Sustituya el dominio antes de aplicar.

{$ENCUENTRO_DOMAIN} {
	encode gzip zstd

	# TLS lo gestiona Caddy. La aplicación asume que llega tráfico ya cifrado:
	# `useSecureCookies` en producción depende de ello (ver P04).
	header {
		# HSTS. Un año, con subdominios. Solo activarlo cuando el dominio ya
		# sirva TLS de forma estable: revertirlo es lento porque los navegadores
		# recuerdan la cabecera.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"

		# La verificación pública de comprobante no debe indexarse. La página ya
		# lo declara con su metadata; esto lo refuerza a nivel de proxy.
		-Server
	}

	# Verificación pública de comprobante — PAY-031.
	#
	# ATENCIÓN: este bloque decía «rate limit del endpoint público» y NO CONTIENE
	# NINGUNA DIRECTIVA QUE LO HAGA. Nunca la tuvo: `caddy:2-alpine` no trae
	# limitación de ritmo de serie —requiere compilar con el módulo
	# `caddy-ratelimit` vía xcaddy—, así que el comentario prometía una
	# protección inexistente y quien leyera el Caddyfile la daría por puesta.
	#
	# El riesgo real no es la fuerza bruta sobre el token: son 32 bytes y no se
	# adivina. Es que la ruta es anónima, sin cuota, y cada petición fuerza
	# render dinámico en el proceso web. Un solo cliente puede saturar la
	# aplicación durante el evento, que es cuando más caro sale.
	#
	# PENDIENTE. Dos caminos, y ninguno se elige aquí sin decidirlo:
	#   1. Imagen propia de Caddy con `caddy-ratelimit` (xcaddy), y este bloque
	#      pasa a llevar la directiva de verdad.
	#   2. Límite en la aplicación, que además puede contar por token y no solo
	#      por IP.
	#
	# Mientras tanto se deja lo único que sí se puede hacer sin plugin: aislar la
	# ruta en su propio bloque —ya lo estaba— para que aplicar el límite sea
	# cambiar estas líneas y nada más.
	@verificacion path /verificar/comprobante/*
	handle @verificacion {
		reverse_proxy web:3000
	}

	# El resto del tráfico.
	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
	}
}

# Redirección de HTTP a HTTPS. Caddy la hace por defecto; queda explícita para
# que no dependa de un comportamiento implícito.
http://{$ENCUENTRO_DOMAIN} {
	redir https://{host}{uri} permanent
}

NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://encuentro:encuentro@localhost:5432/encuentro

# Base del recorrido automatizado (`pnpm test:e2e`). Tiene que ser **distinta**
# de DATABASE_URL: la siembra deja catálogo que la limpieza no puede retirar, y
# para borrar los cargos apaga un disparador de solo anexado. Créela con
# `pnpm db:e2e`.
E2E_DATABASE_URL=postgresql://encuentro:encuentro@localhost:5432/encuentro_e2e
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=encuentro-private
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RECEIPT_VERIFICATION_SECRET=change-me
SESSION_SECRET=change-me

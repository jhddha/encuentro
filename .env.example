NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://encuentro:encuentro@localhost:5432/encuentro

# Dos suites vacían lo que tocan, así que ninguna puede apuntar aquí arriba.
# Las dos variables son obligatorias y tienen que ser distintas de DATABASE_URL.
#
# Pruebas de integración: hacen TRUNCATE de todo el esquema entre pruebas.
# El 11-ago-2026 se ejecutaron contra la base de desarrollo y borraron un
# recorrido manual completo. Créela con `pnpm db:test`.
TEST_DATABASE_URL=postgresql://encuentro:encuentro@localhost:5432/encuentro_test

# Recorrido de extremo a extremo: siembra catálogo que su limpieza no retira y
# apaga un disparador de solo anexado para borrar cargos. `pnpm db:e2e`.
E2E_DATABASE_URL=postgresql://encuentro:encuentro@localhost:5432/encuentro_e2e
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=encuentro-private
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RECEIPT_VERIFICATION_SECRET=change-me
SESSION_SECRET=change-me
